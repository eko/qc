## digest, video from 0.000000
ffmpeg -v error -nostdin -y -seek_timestamp 1 -ss 0.000000 -t 2.000000 -i src.mov -seek_timestamp 1 -ss 10.000000 -t 2.000000 -i src.mov -filter_complex [0:v:0]format=yuv420p,setsar=1[v0];[1:v:0]format=yuv420p,setsar=1[v1];[v0][v1]concat=n=2:v=1:a=0,setpts=N/(25/1*TB)[out] -map [out] -an -r 25/1 -c:v rawvideo -f nut digest.nut
## digest, video from 0.200000
ffmpeg -v error -nostdin -y -seek_timestamp 1 -ss 0.200000 -t 2.000000 -i src.mov -seek_timestamp 1 -ss 10.200000 -t 2.000000 -i src.mov -filter_complex [0:v:0]format=yuv420p,setsar=1[v0];[1:v:0]format=yuv420p,setsar=1[v1];[v0][v1]concat=n=2:v=1:a=0,setpts=N/(25/1*TB)[out] -map [out] -an -r 25/1 -c:v rawvideo -f nut digest.nut
